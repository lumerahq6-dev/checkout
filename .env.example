# Paddle.js (Billing) — https://developer.paddle.com/paddlejs/client-side-tokens
# Dashboard → Developer tools → Authentication → Client-side tokens
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Server API key — Dashboard → Authentication → API keys. Use only in API routes / webhooks.
# Never prefix with NEXT_PUBLIC_ (must not ship to the browser).
PADDLE_API_KEY=

# Omit for production (live tokens). Set to "sandbox" only when using sandbox + test_ tokens.
NEXT_PUBLIC_PADDLE_ENV=

# Dashboard → Checkout → Default payment link: https://yourdomain.com (site must load Paddle.js)
